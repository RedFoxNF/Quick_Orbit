<Window x:Class="QuickOrbit.Views.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:QuickOrbit.Models"
        Title="Элемент орбиты"
        Width="560" Height="590"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBgBrush}"
        ShowInTaskbar="False">
    <Border BorderBrush="{StaticResource BorderBrushStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#0D131B" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Ellipse Width="18" Height="18" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                    <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}" Margin="-12,0,0,0" />
                    <TextBlock x:Name="HeaderText" Text="Новый элемент" FontFamily="Segoe UI Semibold"
                               FontSize="15" Margin="17,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="✕"
                        HorizontalAlignment="Right" Margin="0,0,12,0" Click="Cancel_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,18,20,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="58" Height="58" CornerRadius="15"
                                Background="#111B25" BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1" HorizontalAlignment="Left">
                            <Grid>
                                <Image x:Name="IconPreview" Stretch="Uniform" Margin="9" />
                                <TextBlock x:Name="FallbackText" Text="?"
                                           FontFamily="Segoe UI Semibold" FontSize="23"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Тип элемента" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="TypeCombo" SelectedValuePath="Tag" SelectionChanged="TypeCombo_SelectionChanged">
                                <ComboBoxItem Content="Файл или программа" Tag="{x:Static models:ItemType.File}" />
                                <ComboBoxItem Content="Сайт в браузере" Tag="{x:Static models:ItemType.Url}" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Название" Style="{StaticResource FieldLabel}" Margin="0,20,0,6" />
                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" />

                    <TextBlock x:Name="TargetLabel" Text="Путь к программе или файлу"
                               Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetBox" Grid.Column="0"
                                 Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="Обзор…"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Browse_Click" />
                    </Grid>
                    <TextBlock x:Name="TargetHint" Style="{StaticResource HintText}" Margin="0,6,0,0"
                               Text="Можно указать полный путь или имя команды Windows, например notepad.exe." />

                    <TextBlock Text="Иконка (необязательно)" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="False" />
                        <Button Grid.Column="1" Content="Файл…" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Click="IconBrowse_Click" />
                        <Button x:Name="FaviconButton" Grid.Column="2" Content="Favicon"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Click="Favicon_Click" />
                    </Grid>
                    <TextBlock x:Name="IconHint" Style="{StaticResource HintText}" Margin="0,6,0,0"
                               Text="Пусто — иконка извлекается автоматически. Для сайта favicon скачивается при сохранении." />

                    <Border Margin="0,18,0,0" Padding="12,9" CornerRadius="7" Background="#0C141D"
                            BorderBrush="#243346" BorderThickness="1">
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                   TextWrapping="Wrap" Text="Иконка выбирается один раз при добавлении и кэшируется локально." />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="20,10,20,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Style="{StaticResource GhostButton}" Width="98"
                            Margin="0,0,10,0" Click="Cancel_Click" />
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}"
                            AutomationProperties.Name="Сохранить"
                            Width="128" Click="Save_Click">
                        <TextBlock Text="Сохранить" Foreground="#041116" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
