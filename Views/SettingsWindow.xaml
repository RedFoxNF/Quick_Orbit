<Window x:Class="QuickOrbit.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuickOrbit.Views"
        xmlns:utils="clr-namespace:QuickOrbit.Utilities"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Quick Orbit — настройки"
        Width="1180" Height="760"
        MinWidth="1020" MinHeight="680"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        ShowInTaskbar="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <utils:ItemTypeToRussianConverter x:Key="ItemTypeConverter" />
        <utils:IconDisplayConverter x:Key="IconDisplayConverter" />
    </Window.Resources>

    <Border Background="{StaticResource WindowBgBrush}"
            BorderBrush="{StaticResource BorderBrushStrong}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#0C121A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Grid Width="26" Height="26">
                        <Ellipse Width="22" Height="11" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.2"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-24" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="{StaticResource AccentBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="1,0,2,4" />
                    </Grid>
                    <TextBlock Text="QUICK ORBIT" FontFamily="Segoe UI Semibold" FontSize="12.5"
                               Foreground="{StaticResource TextBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="настройки" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Margin="10,1,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="—" Click="Minimize_Click"
                            FontSize="14" ToolTip="Свернуть" />
                    <Button Style="{StaticResource IconButton}" Content="✕" Click="Close_Click"
                            FontSize="13" Margin="4,0,0,0" ToolTip="Закрыть" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="18,16,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="690" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Общие" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Глобальное сочетание клавиш" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Draft.Hotkey, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas" FontSize="13" />
                                        <TextBlock Text="Например: Ctrl+Alt+Space" Style="{StaticResource HintText}" Margin="0,5,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Тема" Style="{StaticResource FieldLabel}" />
                                        <ComboBox SelectedValue="{Binding Draft.Theme, Mode=TwoWay}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Тёмная" Tag="Dark" />
                                            <ComboBoxItem Content="Светлая" Tag="Light" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Угол экрана" Style="{StaticResource FieldLabel}" />
                                        <ComboBox SelectedValue="{Binding Draft.Corner, Mode=TwoWay}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Справа сверху" Tag="TopRight" />
                                            <ComboBoxItem Content="Слева сверху" Tag="TopLeft" />
                                            <ComboBoxItem Content="Справа снизу" Tag="BottomRight" />
                                            <ComboBoxItem Content="Слева снизу" Tag="BottomLeft" />
                                        </ComboBox>
                                    </StackPanel>

                                    <Grid Grid.Row="4" Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="Отступ от края" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding Draft.EdgeMargin, StringFormat={}{0:F0}}"
                                                       HorizontalAlignment="Right" FontSize="11.5"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Grid>
                                        <Slider Grid.Row="1" Minimum="0" Maximum="180"
                                                Value="{Binding Draft.EdgeMargin, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Grid.Row="4" Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="Прозрачность оверлея" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding Draft.OverlayOpacity, StringFormat={}{0:F2}}"
                                                       HorizontalAlignment="Right" FontSize="11.5"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Grid>
                                        <Slider Grid.Row="1" Minimum="0.2" Maximum="1"
                                                Value="{Binding Draft.OverlayOpacity, Mode=TwoWay}" />
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Акцентный цвет" Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Draft.AccentColor, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="Consolas" />
                                            <Border Grid.Column="1" Width="34" Height="32" Margin="8,0,0,0"
                                                    CornerRadius="7" BorderBrush="{StaticResource BorderBrushStrong}"
                                                    BorderThickness="1" Background="{Binding AccentPreviewBrush}" />
                                        </Grid>
                                    </StackPanel>

                                    <Grid Grid.Row="0" Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="Сила свечения" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding Draft.GlowIntensity, StringFormat={}{0:F2}}"
                                                       HorizontalAlignment="Right" FontSize="11.5"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Grid>
                                        <Slider Grid.Row="1" Minimum="0" Maximum="1.6"
                                                Value="{Binding Draft.GlowIntensity, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Grid.Row="0" Grid.Column="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="Параллакс, °" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding Draft.ParallaxDegrees, StringFormat={}{0:F1}}"
                                                       HorizontalAlignment="Right" FontSize="11.5"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Grid>
                                        <Slider Grid.Row="1" Minimum="0" Maximum="8"
                                                Value="{Binding Draft.ParallaxDegrees, Mode=TwoWay}" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Иконки" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Форма" Style="{StaticResource FieldLabel}" />
                                        <ComboBox SelectedValue="{Binding Draft.IconShape, Mode=TwoWay}"
                                                  SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Скруглённый квадрат" Tag="RoundedSquare" />
                                            <ComboBoxItem Content="Круг" Tag="Circle" />
                                        </ComboBox>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="Размер иконок настраивается отдельно для каждой орбиты ниже. Галочка «Применять ко всем орбитам» синхронизирует изменение."
                                               Style="{StaticResource HintText}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Орбиты" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-3,0,10">
                                        <Button Content="+ Орбита" Style="{StaticResource GhostButton}"
                                                Padding="10,5" Click="AddOrbit_Click" />
                                        <Button Content="Удалить" Style="{StaticResource DangerButton}"
                                                Padding="10,5" Margin="8,0,0,0" Click="RemoveOrbit_Click" />
                                    </StackPanel>
                                </Grid>

                                <ComboBox ItemsSource="{Binding Orbits}"
                                          SelectedItem="{Binding SelectedOrbit, Mode=TwoWay}"
                                          DisplayMemberPath="Name" FontSize="12.5" />

                                <StackPanel IsEnabled="{Binding HasSelectedOrbit}" Margin="0,14,0,0">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Название кольца" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding SelectedOrbit.Name, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <TextBlock Text="Радиус" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Text="{Binding SelectedOrbit.Radius, StringFormat={}{0:F0}}"
                                                           HorizontalAlignment="Right" FontSize="11.5"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </Grid>
                                            <Slider Grid.Row="1" Minimum="60" Maximum="420"
                                                    Value="{Binding SelectedOrbit.Radius, Mode=TwoWay}" />
                                        </Grid>

                                        <Grid Grid.Row="0" Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <TextBlock Text="Наклон, °" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Text="{Binding SelectedOrbit.Tilt, StringFormat={}{0:F0}}"
                                                           HorizontalAlignment="Right" FontSize="11.5"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </Grid>
                                            <Slider Grid.Row="1" Minimum="12" Maximum="75"
                                                    Value="{Binding SelectedOrbit.Tilt, Mode=TwoWay}" />
                                        </Grid>

                                        <Grid Grid.Row="0" Grid.Column="4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <TextBlock Text="Скорость, °/с" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Text="{Binding SelectedOrbit.Speed, StringFormat={}{0:F1}}"
                                                           HorizontalAlignment="Right" FontSize="11.5"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </Grid>
                                            <Slider Grid.Row="1" Minimum="-30" Maximum="30"
                                                    Value="{Binding SelectedOrbit.Speed, Mode=TwoWay}" />
                                        </Grid>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <TextBlock Text="Размер иконок" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Text="{Binding SelectedOrbit.IconSize, StringFormat={}{0:F0} px}"
                                                           HorizontalAlignment="Right" FontSize="11.5"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </Grid>
                                            <Slider x:Name="OrbitIconSizeSlider" Grid.Row="1"
                                                    Minimum="32" Maximum="96"
                                                    Value="{Binding SelectedOrbit.IconSize, Mode=TwoWay}"
                                                    ValueChanged="OrbitIconSizeSlider_ValueChanged" />
                                        </Grid>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                            <CheckBox x:Name="SyncIconSizeCheckBox"
                                                      Content="Применять ко всем орбитам"
                                                      Checked="SyncIconSize_Checked" />
                                            <TextBlock Text="При включении текущий размер выбранной орбиты применится ко всем."
                                                       Style="{StaticResource HintText}" Margin="0,7,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Элементы кольца" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Двойной клик по строке — изменить. Файлы и ссылки можно перетащить прямо в таблицу."
                                                   Style="{StaticResource HintText}" Margin="0,-7,0,10" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-3,0,10">
                                        <Button Style="{StaticResource PrimaryButton}"
                                                AutomationProperties.Name="Добавить"
                                                Padding="11,5" Click="AddItem_Click">
                                            <TextBlock Text="Добавить" Foreground="#041116" />
                                        </Button>
                                        <Button Content="Изменить" Style="{StaticResource GhostButton}"
                                                Padding="10,5" Margin="8,0,0,0" Click="EditItem_Click" />
                                        <Button Content="Удалить" Style="{StaticResource DangerButton}"
                                                Padding="10,5" Margin="8,0,0,0" Click="DeleteItem_Click" />
                                    </StackPanel>
                                </Grid>

                                <DataGrid x:Name="ItemsGrid"
                                          ItemsSource="{Binding SelectedOrbit.Items}"
                                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                          Height="250"
                                          IsEnabled="{Binding HasSelectedOrbit}"
                                          AllowDrop="True"
                                          PreviewDragOver="ItemsGrid_DragOver"
                                          PreviewDrop="ItemsGrid_Drop"
                                          MouseDoubleClick="ItemsGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="НАЗВАНИЕ" Width="1.15*" Binding="{Binding Name}" />
                                        <DataGridTextColumn Header="ТИП" Width="62"
                                                            Binding="{Binding Type, Converter={StaticResource ItemTypeConverter}}" />
                                        <DataGridTextColumn Header="ЦЕЛЬ" Width="1.65*" Binding="{Binding Target}" />
                                        <DataGridTextColumn Header="ИКОНКА" Width="88"
                                                            Binding="{Binding Icon, Converter={StaticResource IconDisplayConverter}}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Иконки EXE извлекаются Win32-API. Favicon скачивается при добавлении и кэшируется."
                                           Style="{StaticResource HintText}" Margin="0,9,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0A1019" Offset="0" />
                                <GradientStop Color="#070C12" Offset="0.55" />
                                <GradientStop Color="#050A10" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="48" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ЖИВОЕ ПРЕВЬЮ" FontFamily="Segoe UI Semibold" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#0D1A20" BorderBrush="#1C3C45" BorderThickness="1"
                                    CornerRadius="10" Padding="9,4">
                                <TextBlock Text="LIVE" FontSize="9.5" FontFamily="Segoe UI Semibold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="4">
                            <local:OrbitSurface x:Name="PreviewSurface" AutoFit="True" IsHitTestVisible="False" />
                            <TextBlock Text="ТАК МЕНЮ ВЫГЛЯДИТ НА ЭКРАНЕ" FontSize="9.5" Opacity="0.55"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom"
                                       HorizontalAlignment="Center" Margin="0,0,0,7" />
                        </Grid>

                        <Border Grid.Row="2" BorderBrush="#16212D" BorderThickness="0,1,0,0"
                                Background="#080D13" Padding="16,0">
                            <Grid>
                                <TextBlock Text="Применяется без перезапуска" Style="{StaticResource HintText}"
                                           VerticalAlignment="Center" />
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                    Background="#0C121A" Padding="18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusLabel" Grid.Column="0" VerticalAlignment="Center"
                               Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,16,0"
                               Text="Изменения вступают в силу после нажатия «Применить»." />
                    <Button Grid.Column="1" Content="Закрыть" Style="{StaticResource GhostButton}"
                            Width="100" Margin="0,0,10,0" Click="Close_Click" />
                    <Button x:Name="ApplyButton" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                            AutomationProperties.Name="Применить"
                            Width="132" Click="Apply_Click">
                        <TextBlock Text="Применить" Foreground="#041116" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
